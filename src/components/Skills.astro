---
import { Icon } from "astro-icon/components";

const categories = [
  {
    name: "Frontend",
    color: "#06b6d4",
    items: [
      { name: "HTML", icon: "simple-icons:html5" },
      { name: "CSS", icon: "simple-icons:css3" },
      { name: "JavaScript", icon: "simple-icons:javascript" },
      { name: "React", icon: "simple-icons:react" },
      { name: "Next.js", icon: "simple-icons:nextdotjs" },
      { name: "Vue", icon: "simple-icons:vuedotjs" },
      { name: "Angular", icon: "simple-icons:angular" },
      { name: "Bootstrap", icon: "simple-icons:bootstrap" },
      { name: "TailwindCSS", icon: "simple-icons:tailwindcss" },
    ],
  },
  {
    name: "Backend",
    color: "#8b5cf6",
    items: [
      { name: "Node.js", icon: "simple-icons:nodedotjs" },
      { name: "Express", icon: "simple-icons:express" },
      { name: "Python", icon: "simple-icons:python" },
      { name: "Django", icon: "simple-icons:django" },
      { name: "Flask", icon: "simple-icons:flask" },
      { name: "PHP", icon: "simple-icons:php" },
      { name: "Laravel", icon: "simple-icons:laravel" },
      { name: "Ruby on Rails", icon: "simple-icons:rubyonrails" },
      { name: "Java Spring", icon: "simple-icons:spring" },
    ],
  },
  {
    name: "Bases de Datos",
    color: "#f59e0b",
    items: [
      { name: "MySQL", icon: "simple-icons:mysql" },
      { name: "PostgreSQL", icon: "simple-icons:postgresql" },
      { name: "MongoDB", icon: "simple-icons:mongodb" },
      { name: "Supabase", icon: "simple-icons:supabase" },
    ],
  },
  {
    name: "DevOps & Herramientas",
    color: "#f472b6",
    items: [
      { name: "Git", icon: "simple-icons:git" },
      { name: "GitHub", icon: "simple-icons:github" },
      { name: "Docker", icon: "simple-icons:docker" },
      { name: "CI/CD", icon: "lucide:refresh-cw" },
      { name: "Vercel", icon: "simple-icons:vercel" },
      { name: "Netlify", icon: "simple-icons:netlify" },
      { name: "AWS", icon: "simple-icons:amazonwebservices" },
      { name: "Firebase", icon: "simple-icons:firebase" },
    ],
  },
];
---

<section class="section" id="habilidades">
  <div class="container">
    <div class="sec-head reveal">
      <span class="sec-tag" data-i18n="skills.tag" style="border-color: rgba(139,92,246,0.12); color: #8b5cf6; background: rgba(139,92,246,0.08);">Stack Tecnológico</span>
      <h2 class="sec-title">
        <span data-i18n="skills.title">Mi caja de</span>
        <span class="gradient-text" data-i18n="skills.title.highlight" style="background: linear-gradient(135deg, #8b5cf6, #f472b6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">herramientas</span>
      </h2>
      <p class="sec-desc" data-i18n="skills.desc">
        Tecnologías con las que trabajo día a día para construir soluciones web
        modernas y escalables.
      </p>
    </div>

    <div class="skills-board stagger">
      {categories.map((cat, i) => (
        <div class="skill-cluster">
          <div class="cluster-head">
            <span class="cluster-line" style="background: {cat.color};"></span>
            <h3 class="cluster-name" data-i18n={`skills.cat.${i}`}>{cat.name}</h3>
            <span class="cluster-count">{cat.items.length}</span>
          </div>
          <div class="cluster-items">
            {cat.items.map((skill) => (
              <span class="skill-chip">
                <Icon name={skill.icon} class="chip-icon" />
                <span class="chip-name">{skill.name}</span>
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .skills-board {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .skill-cluster {
    padding: 28px 32px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.3s ease;
  }

  .skill-cluster:hover {
    border-color: var(--overlay-border-hover);
  }

  .cluster-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .cluster-line {
    width: 3px;
    height: 20px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .cluster-name {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text);
    flex: 1;
  }

  .cluster-count {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--overlay);
    padding: 2px 10px;
    border-radius: 50px;
    font-family: var(--font-mono);
  }

  .cluster-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    border-radius: 50px;
    transition: all 0.3s ease;
    cursor: default;
  }

  .skill-chip:hover {
    background: var(--overlay-hover);
    border-color: var(--overlay-border-hover);
    transform: translateY(-2px);
  }

  .chip-icon {
    width: 18px;
    height: 18px;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color 0.3s ease;
  }

  .skill-chip:hover .chip-icon {
    color: var(--text);
  }

  .chip-name {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .skill-cluster {
      padding: 20px;
    }
    .skill-chip {
      padding: 6px 12px;
    }
    .chip-icon {
      width: 16px;
      height: 16px;
    }
    .chip-name {
      font-size: 0.8rem;
    }
  }
</style>
