---
import { Icon } from "astro-icon/components";

const services = [
  {
    id: "01",
    icon: "lucide:globe",
    title: "Aplicaciones Web",
    desc: "Desarrollo de aplicaciones web completas con arquitectura robusta, escalable y moderna. Desde dashboards hasta plataformas SaaS.",
    tags: ["React", "Node.js", "PostgreSQL"],
  },
  {
    id: "02",
    icon: "lucide:layout",
    title: "Páginas Web",
    desc: "Sitios web responsivos, optimizados para SEO y con diseño atractivo. Landing pages, portafolios, sitios corporativos y más.",
    tags: ["Next.js", "TailwindCSS", "Vercel"],
  },
  {
    id: "03",
    icon: "lucide:monitor",
    title: "Frontend",
    desc: "Interfaces de usuario interactivas y dinámicas. Experiencias fluidas con rendimiento optimizado y diseño adaptativo.",
    tags: ["React", "Vue", "Angular"],
  },
  {
    id: "04",
    icon: "lucide:server",
    title: "Backend",
    desc: "APIs RESTful, autenticación, bases de datos y lógica del servidor. Arquitecturas sólidas y seguras para cualquier proyecto.",
    tags: ["Node.js", "Python", "PHP"],
  },
  {
    id: "05",
    icon: "lucide:smartphone",
    title: "Responsive Design",
    desc: "Diseños que se adaptan perfectamente a cualquier dispositivo. Experiencia consistente en móvil, tablet y escritorio.",
    tags: ["CSS", "Bootstrap", "TailwindCSS"],
  },
  {
    id: "06",
    icon: "lucide:cloud",
    title: "DevOps & Deploy",
    desc: "Despliegue continuo, contenedores Docker, integración continua y configuración de infraestructura en la nube.",
    tags: ["Docker", "AWS", "CI/CD"],
  },
];
---

<section class="section" id="servicios">
  <div class="container">
    <div class="sec-head reveal">
      <span class="sec-tag" data-i18n="services.tag">Servicios</span>
      <h2 class="sec-title">
        <span data-i18n="services.title">Transformo ideas en</span><br />
        <span class="gradient-text" data-i18n="services.title.highlight">productos digitales</span>
      </h2>
      <p class="sec-desc" data-i18n="services.desc">
        Desde el concepto hasta el despliegue, ofrezco soluciones completas de
        desarrollo web con tecnologías modernas.
      </p>
    </div>

    <div class="services-track stagger">
      {services.map((s, i) => (
        <article class="svc-card data-i18n-service">
          <span class="svc-id">{s.id}</span>
          <div class="svc-icon-wrap">
            <Icon name={s.icon} class="svc-icon" />
          </div>
          <div class="svc-body">
            <h3 class="svc-title" data-i18n={`services.${i}.title`}>{s.title}</h3>
            <p class="svc-desc" data-i18n={`services.${i}.desc`}>{s.desc}</p>
            <div class="svc-tags" data-i18n-tags={`services.${i}.tags`}>
              {s.tags.map((tag) => (
                <span class="svc-tag">{tag}</span>
              ))}
            </div>
          </div>
          <div class="svc-arrow">
            <Icon name="lucide:arrow-up-right" />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .sec-head {
    margin-bottom: 64px;
    max-width: 640px;
  }

  .sec-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent-1);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    padding: 6px 14px;
    border-radius: 50px;
    margin-bottom: 16px;
  }

  .sec-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 16px;
    letter-spacing: -1px;
  }

  .sec-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.8;
    max-width: 500px;
  }

  .services-track {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .svc-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    gap: 8px 16px;
    padding: 28px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    position: relative;
    overflow: hidden;
    cursor: default;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .svc-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(600px circle at var(--mx, 50%) var(--my, 50%), rgba(6, 182, 212, 0.04), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .svc-card:hover::before {
    opacity: 1;
  }

  .svc-card:hover {
    border-color: rgba(6, 182, 212, 0.15);
    transform: translateY(-3px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.25);
  }

  .svc-id {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.15);
    grid-row: 1;
    grid-column: 1;
    align-self: start;
  }

  .svc-icon-wrap {
    grid-row: 1 / 3;
    grid-column: 1;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 182, 212, 0.06);
    border: 1px solid rgba(6, 182, 212, 0.1);
    border-radius: 12px;
    margin-top: 4px;
    transition: all 0.3s ease;
  }

  .svc-card:hover .svc-icon-wrap {
    background: rgba(6, 182, 212, 0.12);
    border-color: rgba(6, 182, 212, 0.2);
    transform: scale(1.05);
  }

  .svc-icon {
    width: 22px; height: 22px;
    color: var(--accent-1);
  }

  .svc-body {
    grid-column: 2;
    grid-row: 1 / 3;
  }

  .svc-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .svc-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .svc-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .svc-tag {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--accent-1);
    background: rgba(6, 182, 212, 0.06);
    border: 1px solid rgba(6, 182, 212, 0.1);
    padding: 3px 10px;
    border-radius: 50px;
  }

  .svc-arrow {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
    color: rgba(255, 255, 255, 0.15);
    width: 20px; height: 20px;
    transition: all 0.3s ease;
  }

  .svc-card:hover .svc-arrow {
    color: var(--accent-1);
    transform: translate(2px, -2px);
  }

  @media (max-width: 768px) {
    .services-track {
      grid-template-columns: 1fr;
    }

    .svc-card {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      gap: 12px;
    }

    .svc-id { display: none; }
    .svc-icon-wrap { grid-row: auto; grid-column: auto; }
    .svc-body { grid-column: auto; grid-row: auto; }
    .svc-arrow { display: none; }
  }
</style>

<script>
  document.querySelectorAll(".svc-card").forEach((card) => {
    card.addEventListener("mousemove", (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty("--mx", `${x}px`);
      card.style.setProperty("--my", `${y}px`);
    });
  });
</script>
